@page "/"
@using Omron2Garmin.Web.Models
@using Omron2Garmin.Web.Services
@inject GarminService GarminService
@inject OmronCsvParser CsvParser
@inject TimezoneService TimezoneService
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>OMRON to Garmin Sync</PageTitle>

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5">
                <i class="bi bi-heart-pulse me-2"></i>
                OMRON to Garmin Connect
            </h1>
            <p class="lead text-muted">Upload your OMRON blood pressure and weight CSV export to Garmin Connect</p>
        </div>
    </div>

    @* Login Section *@
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-person-circle me-2"></i>
                Step 1: Garmin Connect Login
            </h5>
        </div>
        <div class="card-body">
            @if (GarminService.IsAuthenticated)
            {
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="badge bg-success me-2">
                            <i class="bi bi-check-circle me-1"></i>Connected
                        </span>
                        <span>Logged in as <strong>@GarminService.DisplayName</strong></span>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                </div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" @bind="email" placeholder="your@email.com" disabled="@isLoggingIn" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Password</label>
                        <input type="password" class="form-control" @bind="password" placeholder="Password" disabled="@isLoggingIn" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary w-100" @onclick="Login" disabled="@isLoggingIn">
                            @if (isLoggingIn)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Logging in...</span>
                            }
                            else
                            {
                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                <span>Login</span>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(loginError))
                {
                    <div class="alert alert-danger mt-3 mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>@loginError
                    </div>
                }
            }
        </div>
    </div>

    @* Upload Section *@
    <div class="card mb-4 @(GarminService.IsAuthenticated ? "" : "opacity-50")">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-upload me-2"></i>
                Step 2: Upload OMRON CSV
            </h5>
        </div>
        <div class="card-body">
            @if (!GarminService.IsAuthenticated)
            {
                <p class="text-muted mb-0">Please login to Garmin Connect first.</p>
            }
            else
            {
                <div class="row mb-3">
                    <div class="col-md-8">
                        <label class="form-label">Select your OMRON Connect CSV export file</label>
                        <InputFile class="form-control" OnChange="HandleFileSelected" accept=".csv" disabled="@isUploading" />
                        <div class="form-text">
                            Export your data from the OMRON Connect app and upload the CSV file here.
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">CSV Timezone</label>
                        <select class="form-select" @bind="selectedTimezone" disabled="@isUploading">
                            @foreach (var tz in availableTimezones)
                            {
                                <option value="@tz.IanaId">@tz.DisplayName</option>
                            }
                        </select>
                        <div class="form-text">
                            @if (!string.IsNullOrEmpty(detectedTimezone))
                            {
                                <i class="bi bi-check-circle text-success me-1"></i>
                                <span>Auto-detected: @detectedTimezone</span>
                            }
                            else
                            {
                                <span>Timezone used when the CSV was exported</span>
                            }
                        </div>
                    </div>
                </div>

                @if ((parsedReadings.Count > 0 || parsedWeights.Count > 0) && !isUploading && syncResult == null && weightSyncResult == null)
                {
                    @* Blood Pressure Preview *@
                    @if (parsedReadings.Count > 0)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-heart-pulse me-2"></i>
                            Found <strong>@parsedReadings.Count</strong> blood pressure readings.
                            <span class="d-block mt-1">
                                Date range: @parsedReadings.Min(r => r.Timestamp).ToString("d") - @parsedReadings.Max(r => r.Timestamp).ToString("d")
                            </span>
                        </div>

                        <h6><i class="bi bi-heart-pulse me-1"></i>Blood Pressure Preview (last 5):</h6>
                        <div class="table-responsive mb-3">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Date/Time</th>
                                        <th>Systolic</th>
                                        <th>Diastolic</th>
                                        <th>Pulse</th>
                                        <th>Irregular</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in parsedReadings.OrderByDescending(x => x.Timestamp).Take(5))
                                    {
                                        <tr>
                                            <td>@r.Timestamp.ToString("g")</td>
                                            <td>@r.Systolic</td>
                                            <td>@r.Diastolic</td>
                                            <td>@r.Pulse</td>
                                            <td>@(r.IrregularHeartbeat ? "Yes" : "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @* Weight Preview *@
                    @if (parsedWeights.Count > 0)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-speedometer me-2"></i>
                            Found <strong>@parsedWeights.Count</strong> weight readings.
                            <span class="d-block mt-1">
                                Date range: @parsedWeights.Min(r => r.Timestamp).ToString("d") - @parsedWeights.Max(r => r.Timestamp).ToString("d")
                            </span>
                        </div>

                        <h6><i class="bi bi-speedometer me-1"></i>Weight Preview (last 5):</h6>
                        <div class="table-responsive mb-3">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Date/Time</th>
                                        <th>Weight (kg)</th>
                                        <th>BMI</th>
                                        <th>Category</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var w in parsedWeights.OrderByDescending(x => x.Timestamp).Take(5))
                                    {
                                        <tr>
                                            <td>@w.Timestamp.ToString("g")</td>
                                            <td>@w.WeightKg.ToString("F1")</td>
                                            <td>@(w.Bmi?.ToString("F1") ?? "-")</td>
                                            <td>@(w.Category ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        @if (parsedReadings.Count > 0)
                        {
                            <button class="btn btn-danger" @onclick="UploadBloodPressure">
                                <i class="bi bi-heart-pulse me-1"></i>
                                Upload Blood Pressure (@parsedReadings.Count)
                            </button>
                        }
                        @if (parsedWeights.Count > 0)
                        {
                            <button class="btn btn-success" @onclick="UploadWeight">
                                <i class="bi bi-speedometer me-1"></i>
                                Upload Weight (@parsedWeights.Count)
                            </button>
                        }
                        @if (parsedReadings.Count > 0 && parsedWeights.Count > 0)
                        {
                            <button class="btn btn-primary" @onclick="UploadAll">
                                <i class="bi bi-cloud-upload me-1"></i>
                                Upload All
                            </button>
                        }
                    </div>
                }

                @if (isUploading)
                {
                    <div class="mt-3">
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                 role="progressbar"
                                 style="width: @progressPercent%"
                                 aria-valuenow="@progressPercent"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                                @progressPercent%
                            </div>
                        </div>
                        <p class="text-muted mt-2 mb-0">@progressMessage</p>
                    </div>
                }
            }
        </div>
    </div>

    @* Blood Pressure Results Section *@
    @if (syncResult != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="bi bi-check-circle me-2"></i>
                    Blood Pressure Upload Complete
                </h5>
            </div>
            <div class="card-body">
                <div class="row text-center mb-4">
                    <div class="col-md-3">
                        <div class="display-6 text-primary">@syncResult.TotalReadings</div>
                        <div class="text-muted">Total Readings</div>
                    </div>
                    <div class="col-md-3">
                        <div class="display-6 text-success">@syncResult.Uploaded</div>
                        <div class="text-muted">Uploaded</div>
                    </div>
                    <div class="col-md-3">
                        <div class="display-6 text-warning">@syncResult.Skipped</div>
                        <div class="text-muted">Skipped (Duplicates)</div>
                    </div>
                    <div class="col-md-3">
                        <div class="display-6 text-danger">@syncResult.Failed</div>
                        <div class="text-muted">Failed</div>
                    </div>
                </div>

                @if (syncResult.UploadedReadings.Count > 0)
                {
                    <h6>Uploaded Readings:</h6>
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-sm table-striped">
                            <thead class="sticky-top bg-white">
                                <tr>
                                    <th>Date/Time</th>
                                    <th>Systolic</th>
                                    <th>Diastolic</th>
                                    <th>Pulse</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reading in syncResult.UploadedReadings.OrderByDescending(r => r.Timestamp))
                                {
                                    <tr>
                                        <td>@reading.Timestamp.ToString("g")</td>
                                        <td><span class="badge bg-danger">@reading.Systolic</span></td>
                                        <td><span class="badge bg-primary">@reading.Diastolic</span></td>
                                        <td><span class="badge bg-secondary">@reading.Pulse</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                 @if (syncResult.Errors.Count > 0)
                {
                    <div class="alert alert-warning mt-3">
                        <h6><i class="bi bi-exclamation-triangle me-2"></i>Errors:</h6>
                        <ul class="mb-0">
                            @foreach (var error in syncResult.Errors.Take(10))
                            {
                                <li>@error</li>
                            }
                            @if (syncResult.Errors.Count > 10)
                            {
                                <li>... and @(syncResult.Errors.Count - 10) more</li>
                            }
                        </ul>
                    </div>
                }

                @if (weightSyncResult == null)
                {
                    <button class="btn btn-outline-primary mt-3" @onclick="Reset">
                        <i class="bi bi-arrow-repeat me-1"></i>
                        Upload Another File
                    </button>
                }
            </div>
        </div>
    }

    @* Weight Results Section *@
    @if (weightSyncResult != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="bi bi-speedometer me-2"></i>
                    Weight Upload Complete
                </h5>
            </div>
            <div class="card-body">
                <div class="row text-center mb-4">
                    <div class="col-md-3">
                        <div class="display-6 text-primary">@weightSyncResult.TotalReadings</div>
                        <div class="text-muted">Total Readings</div>
                    </div>
                    <div class="col-md-3">
                        <div class="display-6 text-success">@weightSyncResult.Uploaded</div>
                        <div class="text-muted">Uploaded</div>
                    </div>
                    <div class="col-md-3">
                        <div class="display-6 text-warning">@weightSyncResult.Skipped</div>
                        <div class="text-muted">Skipped (Duplicates)</div>
                    </div>
                    <div class="col-md-3">
                        <div class="display-6 text-danger">@weightSyncResult.Failed</div>
                        <div class="text-muted">Failed</div>
                    </div>
                </div>

                @if (weightSyncResult.UploadedReadings.Count > 0)
                {
                    <h6>Uploaded Readings:</h6>
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-sm table-striped">
                            <thead class="sticky-top bg-white">
                                <tr>
                                    <th>Date/Time</th>
                                    <th>Weight</th>
                                    <th>BMI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var w in weightSyncResult.UploadedReadings.OrderByDescending(r => r.Timestamp))
                                {
                                    <tr>
                                        <td>@w.Timestamp.ToString("g")</td>
                                        <td><span class="badge bg-success">@w.WeightKg.ToString("F1") kg</span></td>
                                        <td><span class="badge bg-info">@(w.Bmi?.ToString("F1") ?? "-")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <button class="btn btn-outline-primary mt-3" @onclick="Reset">
                    <i class="bi bi-arrow-repeat me-1"></i>
                    Upload Another File
                </button>
            </div>
        </div>
    }

    @* Instructions *@
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-question-circle me-2"></i>
                How to export from OMRON Connect
            </h5>
        </div>
        <div class="card-body">
            <ol class="mb-0">
                <li>Open the OMRON Connect app on your phone</li>
                <li>Go to <strong>More</strong> (or Settings)</li>
                <li>Select <strong>Export Data</strong> or <strong>Data Management</strong></li>
                <li>Choose <strong>All data</strong> (or specific: Blood Pressure, Weight)</li>
                <li>Select the date range you want to export</li>
                <li>Export as <strong>CSV</strong> and save/share the file</li>
                <li>Upload the CSV file above</li>
            </ol>
        </div>
    </div>
</div>

@* MFA Modal *@
@if (showMfaModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-shield-lock me-2"></i>
                        Two-Factor Authentication
                    </h5>
                </div>
                <div class="modal-body">
                    <p>Garmin requires a verification code. Please check your email or authenticator app.</p>
                    <div class="mb-3">
                        <label class="form-label">Verification Code</label>
                        <input type="text"
                               class="form-control form-control-lg text-center"
                               @bind="mfaCode"
                               @bind:event="oninput"
                               placeholder="000000"
                               maxlength="6"
                               style="letter-spacing: 0.5em; font-family: monospace;" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelMfa">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SubmitMfa" disabled="@(string.IsNullOrWhiteSpace(mfaCode) || mfaCode.Length < 6)">
                        <i class="bi bi-check-lg me-1"></i>Verify
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string email = "";
    private string password = "";
    private string? loginError;
    private bool isLoggingIn;
    private bool isUploading;
    private int progressPercent;
    private string progressMessage = "";
    private List<BloodPressureReading> parsedReadings = [];
    private List<WeightReading> parsedWeights = [];
    private SyncResult? syncResult;
    private WeightSyncResult? weightSyncResult;

    // Timezone settings
    private string selectedTimezone = "UTC";
    private string? detectedTimezone;
    private List<TimezoneOption> availableTimezones = [];

    // MFA state
    private bool showMfaModal;
    private string mfaCode = "";
    private TaskCompletionSource<string?>? mfaCompletionSource;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize timezone list with common options
            availableTimezones = GetCommonTimezones();

            // Detect browser timezone
            try
            {
                detectedTimezone = await TimezoneService.GetBrowserTimezoneAsync();
                
                // Set as selected if available in list
                if (!string.IsNullOrEmpty(detectedTimezone) && 
                    availableTimezones.Any(t => t.IanaId == detectedTimezone))
                {
                    selectedTimezone = detectedTimezone;
                    StateHasChanged();
                }
            }
            catch
            {
                // Fallback to UTC if detection fails
                selectedTimezone = "UTC";
            }

            // Subscribe to MFA code requests
            GarminService.OnMfaCodeRequired += HandleMfaCodeRequired;
        }
    }

    private List<TimezoneOption> GetCommonTimezones()
    {
        var timezones = new List<TimezoneOption>
        {
            // Europe
            new("Europe/London", "GMT Standard Time", "(UTC+00:00) London"),
            new("Europe/Paris", "Romance Standard Time", "(UTC+01:00) Paris"),
            new("Europe/Berlin", "W. Europe Standard Time", "(UTC+01:00) Berlin"),
            new("Europe/Rome", "W. Europe Standard Time", "(UTC+01:00) Rome"),
            new("Europe/Madrid", "Romance Standard Time", "(UTC+01:00) Madrid"),
            new("Europe/Amsterdam", "W. Europe Standard Time", "(UTC+01:00) Amsterdam"),
            new("Europe/Brussels", "Romance Standard Time", "(UTC+01:00) Brussels"),
            new("Europe/Vienna", "W. Europe Standard Time", "(UTC+01:00) Vienna"),
            new("Europe/Zurich", "W. Europe Standard Time", "(UTC+01:00) Zurich"),
            new("Europe/Stockholm", "W. Europe Standard Time", "(UTC+01:00) Stockholm"),
            new("Europe/Oslo", "W. Europe Standard Time", "(UTC+01:00) Oslo"),
            new("Europe/Copenhagen", "Romance Standard Time", "(UTC+01:00) Copenhagen"),
            new("Europe/Warsaw", "Central European Standard Time", "(UTC+01:00) Warsaw"),
            new("Europe/Prague", "Central European Standard Time", "(UTC+01:00) Prague"),
            new("Europe/Budapest", "Central Europe Standard Time", "(UTC+01:00) Budapest"),
            new("Europe/Bucharest", "E. Europe Standard Time", "(UTC+02:00) Bucharest"),
            new("Europe/Athens", "GTB Standard Time", "(UTC+02:00) Athens"),
            new("Europe/Helsinki", "FLE Standard Time", "(UTC+02:00) Helsinki"),
            new("Europe/Moscow", "Russian Standard Time", "(UTC+03:00) Moscow"),
            // Americas
            new("America/Los_Angeles", "Pacific Standard Time", "(UTC-08:00) Los Angeles"),
            new("America/Denver", "Mountain Standard Time", "(UTC-07:00) Denver"),
            new("America/Chicago", "Central Standard Time", "(UTC-06:00) Chicago"),
            new("America/New_York", "Eastern Standard Time", "(UTC-05:00) New York"),
            new("America/Toronto", "Eastern Standard Time", "(UTC-05:00) Toronto"),
            new("America/Sao_Paulo", "E. South America Standard Time", "(UTC-03:00) São Paulo"),
            // Asia/Pacific
            new("Asia/Dubai", "Arabian Standard Time", "(UTC+04:00) Dubai"),
            new("Asia/Singapore", "Singapore Standard Time", "(UTC+08:00) Singapore"),
            new("Asia/Shanghai", "China Standard Time", "(UTC+08:00) Shanghai"),
            new("Asia/Tokyo", "Tokyo Standard Time", "(UTC+09:00) Tokyo"),
            new("Australia/Sydney", "AUS Eastern Standard Time", "(UTC+10:00) Sydney"),
            // UTC
            new("UTC", "UTC", "(UTC+00:00) UTC")
        };

        // Validate that we can resolve each timezone
        return timezones.Where(t => t.TimeZoneInfo != null).ToList();
    }

    private TimeZoneInfo GetSelectedTimeZone()
    {
        var selected = availableTimezones.FirstOrDefault(t => t.IanaId == selectedTimezone);
        return selected?.TimeZoneInfo ?? TimeZoneInfo.Utc;
    }

    /// <summary>
    /// Represents a timezone option with IANA ID and display name
    /// </summary>
    private class TimezoneOption
    {
        public string IanaId { get; }
        public string WindowsId { get; }
        public string DisplayName { get; }
        public TimeZoneInfo? TimeZoneInfo { get; }

        public TimezoneOption(string ianaId, string windowsId, string displayName)
        {
            IanaId = ianaId;
            WindowsId = windowsId;
            DisplayName = displayName;

            // Try IANA first (Linux/Mac), then Windows ID
            try
            {
                TimeZoneInfo = TimeZoneInfo.FindSystemTimeZoneById(ianaId);
            }
            catch
            {
                try
                {
                    TimeZoneInfo = TimeZoneInfo.FindSystemTimeZoneById(windowsId);
                }
                catch
                {
                    TimeZoneInfo = null;
                }
            }
        }
    }

    private async Task<string?> HandleMfaCodeRequired()
    {
        showMfaModal = true;
        mfaCode = "";
        mfaCompletionSource = new TaskCompletionSource<string?>();
        await InvokeAsync(StateHasChanged);

        // Wait for user to enter code or cancel
        return await mfaCompletionSource.Task;
    }

    private void SubmitMfa()
    {
        showMfaModal = false;
        mfaCompletionSource?.TrySetResult(mfaCode);
        StateHasChanged();
    }

    private void CancelMfa()
    {
        showMfaModal = false;
        mfaCompletionSource?.TrySetResult(null);
        StateHasChanged();
    }

    private async Task Login()
    {
        loginError = null;
        isLoggingIn = true;
        StateHasChanged();

        var (success, error) = await GarminService.LoginAsync(email, password);

        if (!success)
        {
            loginError = error ?? "Login failed";
        }
        else
        {
            password = ""; // Clear password after successful login
        }

        isLoggingIn = false;
    }

    private void Logout()
    {
        GarminService.Logout();
        Reset();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        syncResult = null;
        weightSyncResult = null;
        parsedReadings.Clear();
        parsedWeights.Clear();

        try
        {
            var file = e.File;
            if (file == null)
                return;

            // Limit file size to 10MB
            const long maxSize = 10 * 1024 * 1024;
            await using var stream = file.OpenReadStream(maxSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            // Parse all data types from OMRON CSV
            var parseResult = CsvParser.ParseAllData(memoryStream);
            parsedReadings = parseResult.BloodPressureReadings;
            parsedWeights = parseResult.WeightReadings;
        }
        catch (Exception ex)
        {
            loginError = $"Error reading file: {ex.Message}";
        }
    }

    private async Task UploadBloodPressure()
    {
        if (parsedReadings.Count == 0)
            return;

        isUploading = true;
        progressPercent = 0;
        progressMessage = "Uploading blood pressure readings...";
        StateHasChanged();

        var progress = new Progress<(int Current, int Total, string Message)>(p =>
        {
            progressPercent = (int)((double)p.Current / p.Total * 100);
            progressMessage = p.Message;
            InvokeAsync(StateHasChanged);
        });

        var timezone = GetSelectedTimeZone();
        syncResult = await GarminService.UploadReadingsAsync(parsedReadings, timezone, progress);

        isUploading = false;
        progressPercent = 100;
        progressMessage = "Blood pressure upload complete!";
    }

    private async Task UploadWeight()
    {
        if (parsedWeights.Count == 0)
            return;

        isUploading = true;
        progressPercent = 0;
        progressMessage = "Uploading weight readings...";
        StateHasChanged();

        var progress = new Progress<(int Current, int Total, string Message)>(p =>
        {
            progressPercent = (int)((double)p.Current / p.Total * 100);
            progressMessage = p.Message;
            InvokeAsync(StateHasChanged);
        });

        var timezone = GetSelectedTimeZone();
        weightSyncResult = await GarminService.UploadWeightReadingsAsync(parsedWeights, timezone, progress);

        isUploading = false;
        progressPercent = 100;
        progressMessage = "Weight upload complete!";
    }

    private async Task UploadAll()
    {
        isUploading = true;
        progressPercent = 0;
        StateHasChanged();

        var totalItems = parsedReadings.Count + parsedWeights.Count;
        var processedItems = 0;
        var timezone = GetSelectedTimeZone();

        // Upload blood pressure first
        if (parsedReadings.Count > 0)
        {
            progressMessage = "Uploading blood pressure readings...";
            StateHasChanged();

            var bpProgress = new Progress<(int Current, int Total, string Message)>(p =>
            {
                processedItems = p.Current;
                progressPercent = (int)((double)processedItems / totalItems * 100);
                progressMessage = p.Message;
                InvokeAsync(StateHasChanged);
            });

            syncResult = await GarminService.UploadReadingsAsync(parsedReadings, timezone, bpProgress);
        }

        // Then upload weight
        if (parsedWeights.Count > 0)
        {
            progressMessage = "Uploading weight readings...";
            StateHasChanged();

            var weightProgress = new Progress<(int Current, int Total, string Message)>(p =>
            {
                processedItems = parsedReadings.Count + p.Current;
                progressPercent = (int)((double)processedItems / totalItems * 100);
                progressMessage = p.Message;
                InvokeAsync(StateHasChanged);
            });

            weightSyncResult = await GarminService.UploadWeightReadingsAsync(parsedWeights, timezone, weightProgress);
        }

        isUploading = false;
        progressPercent = 100;
        progressMessage = "All uploads complete!";
    }

    private void Reset()
    {
        parsedReadings.Clear();
        parsedWeights.Clear();
        syncResult = null;
        weightSyncResult = null;
        progressPercent = 0;
        progressMessage = "";
        loginError = null;
    }

    public void Dispose()
    {
        GarminService.OnMfaCodeRequired -= HandleMfaCodeRequired;
    }
}
